<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Espaçador dedicado pro topo (status bar/entalhe) — mais confiável que
         inflar o paddingTop do cabeçalho, porque não depende do
         RelativeLayout recalcular o centerVertical/alignParent dos filhos:
         aqui é só um bloco extra empurrando tudo pra baixo. Altura definida
         em runtime (FastGalleryActivity.kt); preto igual ao cabeçalho pra
         formar uma barra única visualmente. -->
    <View
        android:id="@+id/viewEspacoTopo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#000000" />

    <!-- cabeçalho único, estilo WhatsApp: X redondo pra fechar à esquerda,
         pílula do álbum centralizada, sem título de texto. Preto (não o
         azul da marca) pra combinar com o picker de mídia do WhatsApp que
         serviu de referência. RelativeLayout (não LinearLayout com peso)
         pra pílula ficar compacta/centralizada de verdade, sem esticar pra
         virar uma barra larga. -->
    <RelativeLayout
        android:id="@+id/headerGaleria"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:minHeight="68dp"
        android:elevation="2dp"
        android:background="#000000">

        <TextView
            android:id="@+id/textFechar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="✕"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/bg_botao_fechar_galeria"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/textTrocarAlbum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Câmera ▾"
            android:textColor="#1A1A1A"
            android:textStyle="bold"
            android:textSize="14sp"
            android:background="@drawable/bg_pill_album_galeria"
            android:paddingHorizontal="18dp"
            android:paddingVertical="12dp"
            android:minHeight="44dp"
            android:gravity="center" />
    </RelativeLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerFotos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false" />

</LinearLayout>

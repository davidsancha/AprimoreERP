<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- cabeçalho único, estilo WhatsApp: X redondo pra fechar à esquerda,
         pílula do álbum centralizada — sem título de texto ("Escolher
         fotos" foi removido, o X já comunica "fechar/cancelar"). -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:elevation="2dp"
        android:background="#002F6C">

        <TextView
            android:id="@+id/textFechar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="✕"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/bg_botao_fechar_galeria"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/textTrocarAlbum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Câmera ▾"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp"
            android:background="@drawable/bg_pill_album_galeria"
            android:paddingHorizontal="18dp"
            android:paddingVertical="10dp"
            android:minHeight="40dp"
            android:gravity="center" />
    </RelativeLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerFotos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false" />

</LinearLayout>
